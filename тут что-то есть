# print_module.c

#include "print_module.h"

#include <stdio.h>
#include <time.h>

/* Печать символа с явным привеедением типа */
char print_char(char ch) {
    putchar((int)ch);
    return ch;
}

/* Печать строки посимвольно колбэком */
void print_string(char (*print)(char), const char *s) {
    for (int i = 0; s[i] != '\0'; i++) {
        print(s[i]);
    }
}

/* [LOG] HH:MM:SS message */
void print_log(char (*print)(char), const char *message) {
    print_string(print, Log_prefix);
    print(' ');

    time_t now = time(NULL);
    const struct tm *t = localtime(&now);
    if (t != NULL) {
        char time_buf[16];  // Перенесено внутрь блока if
        strftime(time_buf, sizeof(time_buf), "%H:%M:%S", t);
        print_string(print, time_buf);
    }

    print(' ');
    if (message != NULL) {
        print_string(print, message);
    }
}

