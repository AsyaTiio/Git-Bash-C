# stack_test.c

#include "stack.h"

#include <stdio.h>

int test_push(void);
int test_pop(void);

int main(void) {
    if (test_push() == SUCCESS) {
        printf("SUCCESS\n");
    } else {
        printf("FAIL\n");
    }

    if (test_pop() == SUCCESS) {
        printf("SUCCESS");
    } else {
        printf("FAIL");
    }

    return 0;
}

/* Тест операции push */
int test_push(void) {
    struct stack *s = init();
    if (s == NULL) return FAIL;

    if (push(s, 42) != SUCCESS || push(s, 21) != SUCCESS) {
        destroy(s);
        return FAIL;
    }

    int result = FAIL;
    const struct stack *check_stack = s;

    if (check_stack->top != NULL && check_stack->top->value == 21 && check_stack->top->next != NULL &&
        check_stack->top->next->value == 42) {
        result = SUCCESS;
    }

    destroy(s);
    return result;
}

/* Тест операции pop */
int test_pop(void) {
    struct stack *s = init();
    if (s == NULL) return FAIL;

    push(s, 10);
    push(s, 20);

    int val1 = 0;
    int val2 = 0;
    int res1 = pop(s, &val1);
    int res2 = pop(s, &val2);

    int result = FAIL;
    if (res1 == SUCCESS && val1 == 20 && res2 == SUCCESS && val2 == 10) {
        const struct stack *check_stack = s;
        if (check_stack->top == NULL) {
            result = SUCCESS;
        }
    }

    destroy(s);
    return result;
}
