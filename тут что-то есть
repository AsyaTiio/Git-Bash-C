# stack.c

#include "stack.h"

#include <stdlib.h>

/* Инициализация управляющей структуры стека */
struct stack *init(void) {
    struct stack *s = (struct stack *)malloc(sizeof(struct stack));
    if (s != NULL) {
        s->top = NULL;
    }
    return s;
}

/* Добавление элемента на вершину стека */
int push(struct stack *s, int val) {
    if (s == NULL) return FAIL;

    struct node *new_node = (struct node *)malloc(sizeof(struct node));
    if (new_node == NULL) return FAIL;

    new_node->value = val;
    new_node->next = s->top;
    s->top = new_node;

    return SUCCESS;
}

/* Снятие элемента с вершины стека */
int pop(struct stack *s, int *val) {
    if (s == NULL || s->top == NULL || val == NULL) return FAIL;

    struct node *temp = s->top;
    *val = temp->value;
    s->top = temp->next;
    free(temp);

    return SUCCESS;
}

/* Освобождение всей памяти, занимаемой стеком */
void destroy(struct stack *s) {
    if (s == NULL) return;

    struct node *cur = s->top;
    while (cur != NULL) {
        struct node *next = cur->next;
        free(cur);
        cur = next;
    }
    free(s);
}

